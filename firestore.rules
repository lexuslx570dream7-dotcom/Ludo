rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.userId is string && data.userId.size() > 0
        && data.username is string && data.username.size() > 0
        && data.coins is int && data.coins >= 0
        && data.gems is int && data.gems >= 0
        && data.level is int && data.level >= 1
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidGameRoom(data) {
      return data.id is string && data.id.size() > 0
        && data.mode is string && data.mode.size() > 0
        && data.status is string && data.status in ['WAITING', 'PLAYING', 'COMPLETED']
        && data.creatorId is string && data.creatorId.size() > 0
        && data.playerUids is list && data.playerUids.size() >= 1 && data.playerUids.size() <= 4
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidTournament(data) {
      return data.id is string && data.id.size() > 0
        && data.name is string && data.name.size() > 0
        && data.entryFeeCoins is int && data.entryFeeCoins >= 0
        && data.prizeCoins is int && data.prizeCoins >= 0
        && data.status is string && data.status in ['UPCOMING', 'ACTIVE', 'COMPLETED']
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.userId == userId && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && request.resource.data.userId == userId && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /game_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.creatorId == request.auth.uid
        && (request.auth.uid in request.resource.data.playerUids)
        && isValidGameRoom(request.resource.data);
      allow update: if isAuthenticated()
        && (request.auth.uid in resource.data.playerUids || request.auth.uid in request.resource.data.playerUids)
        && isValidGameRoom(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidTournament(request.resource.data);
      allow update: if isAuthenticated() && isValidTournament(request.resource.data);
      allow delete: if false;
    }
  }
}
